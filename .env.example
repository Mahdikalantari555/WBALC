# Root directory for uploads, checkpoints, exports and the default SQLite DB
STORAGE_DIR=storage

# Async SQLAlchemy URL. Leave unset for SQLite at STORAGE_DIR/rsal.db.
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://rsal:rsal@localhost:5432/rsal

# Patch extraction grid (design open question resolved: 32px, non-overlapping)
PATCH_SIZE=32
# STRIDE=32          # defaults to PATCH_SIZE

# Training
TEST_SIZE=0.25
RANDOM_STATE=42

# Guard rails
MAX_RASTER_ELEMENTS=250000000
MAX_UPLOAD_BYTES=536870912

# --- Docker / launcher settings (read by compose and scripts/*.sh) -----------
# Published host ports. Change these when 8000/3000 are already taken.
# API_PORT=8000
# FRONTEND_PORT=3000
# ORIGIN=https://wbalc.example.org  # only when deployed behind a proxy

# Enable with: ./scripts/dev.sh up --postgres
# Without this line the db container starts but the engine keeps using SQLite,
# which looks like data loss the next time the volume is recreated.
# DATABASE_URL=postgresql+asyncpg://rsal:rsal@db:5432/rsal
# POSTGRES_USER=rsal
# POSTGRES_PASSWORD=rsal
# POSTGRES_DB=rsal

# Build the images through a package mirror on slow/restricted networks.
# Defaults are the official registries.
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org
