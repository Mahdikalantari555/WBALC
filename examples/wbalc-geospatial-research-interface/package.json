{
  "name": "wbalc-research-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/svelte": "^1.75.0",
    "clsx": "^2.1.1",
    "geotiff": "^2.1.3",
    "leaflet": "^1.9.4",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "4.1.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.17",
    "jsdom": "^25.0.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "^3.2.7"
  },
  "description": "WBALC geospatial research workspace: a SvelteKit frontend example running against the live WBALC (RSAL) engine, bilingual (en/fa).",
  "engines": {
    "node": ">=20.19"
  }
